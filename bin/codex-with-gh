#!/usr/bin/env bash
set -eu

minimal_environment=()

add_environment() {
    local name=$1

    if [[ -v $name ]]; then
        minimal_environment+=("$name=${!name}")
    fi
}

if [ -t 0 ] && command -v tty >/dev/null 2>&1; then
    current_tty=$(tty 2>/dev/null || true)
    if [ -n "${current_tty:-}" ] && [ "$current_tty" != "not a tty" ]; then
        export GPG_TTY="$current_tty"
    fi
fi

gh --ensure-auth >/dev/null

if ! command -v pass >/dev/null 2>&1; then
    echo 'codex-with-gh: pass コマンドが必要です。インストールしてください' >&2
    exit 127
fi

if ! token="$(pass show github/cli-token)"; then
    echo 'codex-with-gh: GitHub token を復号できませんでした' >&2
    exit 1
fi

token="$(printf '%s\n' "$token" | head -n 1)"
if [ -z "$token" ]; then
    echo 'codex-with-gh: GitHub token を取得できませんでした' >&2
    exit 1
fi

for name in HOME PATH USER TERM LANG TZ TMPDIR XDG_RUNTIME_DIR; do
    add_environment "$name"
done

for name in "${!LC_@}"; do
    add_environment "$name"
done

exec 3<&0
printf '%s\n' "$token" | env -i "${minimal_environment[@]}" /bin/sh -c '
    IFS= read -r token
    exec 0<&3
    exec 3<&-
    GH_TOKEN="$token" exec codex -c "shell_environment_policy.inherit=\"all\"" "$@"
' codex-with-gh "$@"
