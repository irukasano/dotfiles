#!/bin/sh
set -eu

token_name='github/cli-token'
has_tty=0
is_credential_get=0

if [ "${1:-}" = "auth" ] && [ "${2:-}" = "git-credential" ] && [ "${3:-}" = "get" ]; then
    is_credential_get=1
fi

if [ -t 0 ] && [ -t 2 ]; then
    has_tty=1
fi

set_gpg_tty() {
    if [ -t 0 ] && command -v tty >/dev/null 2>&1; then
        current_tty=$(tty 2>/dev/null || true)
        if [ -n "${current_tty:-}" ] && [ "$current_tty" != "not a tty" ]; then
            export GPG_TTY="$current_tty"
        fi
    fi
}

is_codex_ancestor() {
    pid=$PPID

    while [ "$pid" -gt 0 ] 2>/dev/null; do
        if ! process_row=$(ps -o ppid=,comm= -p "$pid" 2>/dev/null); then
            return 0
        fi
        if [ -z "$process_row" ]; then
            return 0
        fi

        set -- $process_row
        if [ "$#" -lt 2 ]; then
            return 0
        fi
        parent_pid=$1
        process_name=$2

        if [ "$process_name" = "codex" ]; then
            return 0
        fi
        case "$parent_pid" in
            ''|*[!0-9]*) return 0 ;;
        esac
        if [ "$parent_pid" -ge "$pid" ]; then
            return 0
        fi
        pid=$parent_pid
    done

    return 1
}

fail_auth() {
    message=$1
    echo "gh: $message" >&2
    if [ "$is_credential_get" -eq 1 ]; then
        printf 'quit=true\n'
        exit 0
    fi
    exit 1
}

codex_ancestor=0
if is_codex_ancestor; then
    codex_ancestor=1
fi

if [ "$codex_ancestor" -eq 1 ] && [ -z "${GH_TOKEN:-}" ] && \
    [ "${1:-}" = "auth" ] && [ "${2:-}" = "update-token" ]; then
    fail_auth 'Codex 配下では GH_TOKEN を設定してください'
fi

ensure_pass() {
    if ! command -v pass >/dev/null 2>&1; then
        fail_auth 'pass コマンドが必要です。インストールしてください'
    fi
}

update_token() {
    ensure_pass
    set_gpg_tty

    if [ "${1:-}" = "--help" ]; then
        cat >&2 <<'EOF'
usage:
  gh auth update-token
  gh auth update-token --with-token

examples:
  gh auth update-token
  printf '%s\n' "$GITHUB_TOKEN" | gh auth update-token --with-token
EOF
        return 0
    fi

    if [ "${1:-}" = "--with-token" ]; then
        token=$(head -n 1)
        if [ -z "${token:-}" ]; then
            echo "gh: 標準入力からトークンを取得できませんでした" >&2
            return 1
        fi
        printf '%s\n' "$token" | pass insert -m -f "$token_name" >/dev/null
    else
        if [ "$has_tty" -ne 1 ]; then
            echo "gh: 対話端末がないため更新できません。'gh auth update-token --with-token' を使ってください" >&2
            return 1
        fi
        pass insert -f "$token_name"
    fi

    echo "gh: $token_name を更新しました" >&2
    return 0
}

if [ "${1:-}" = "auth" ] && [ "${2:-}" = "update-token" ]; then
    shift 2
    update_token "$@"
    exit $?
fi

if [ "${1:-}" = "--ensure-auth" ]; then
    ensure_auth_only=1
    shift
else
    ensure_auth_only=0
fi

if [ -n "${GH_TOKEN:-}" ]; then
    if [ "$ensure_auth_only" -eq 1 ]; then
        exit 0
    fi
    exec /usr/bin/gh "$@"
fi

ensure_pass
set_gpg_tty

if [ "$codex_ancestor" -eq 1 ]; then
    PASSWORD_STORE_GPG_OPTS="${PASSWORD_STORE_GPG_OPTS:+$PASSWORD_STORE_GPG_OPTS }--batch --pinentry-mode error"
    export PASSWORD_STORE_GPG_OPTS
fi

if ! pass show "$token_name" >/dev/null 2>&1; then
    if [ "$codex_ancestor" -eq 1 ]; then
        fail_auth "$token_name を Codex の sandbox 内から復号できません。元の gh/Git コマンドを昇格実行で再試行してください（require_escalated）。"
    fi

    if [ "$has_tty" -ne 1 ]; then
        fail_auth "$token_name を非対話環境から復号できません。GPG cache が使えないか、gpg-agent に接続できない可能性があります。対話端末から再実行するか GH_TOKEN を設定してください"
    fi

    echo "gh: $token_name が未設定です。これから登録します" >&2
    update_token
fi

token="$(pass show "$token_name" | head -n 1)"
if [ -z "$token" ]; then
    fail_auth "$token_name からトークンを取得できませんでした"
fi

if [ "$ensure_auth_only" -eq 1 ]; then
    exit 0
fi

export GH_TOKEN="$token"
exec /usr/bin/gh "$@"
